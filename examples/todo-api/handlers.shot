import { jsonParse, jsonStringify, wrapError } from 'shot:std'
import type { ShotPromise } from 'shot:std'
import { parse, z } from 'shot:zod'
import {
  createTodo,
  deleteTodo,
  getTodo,
  listTodos,
  updateTodo,
} from './store.shot'
import type { CreateInput, UpdateInput } from './store.shot'

const createSchema = z.object({ title: z.string() })
const updateSchema = z.object({ done: z.boolean() })

function jsonOk(
  body: unknown,
  status: number,
): [Response | null, Error | null] {
  const [json, serializeErr] = jsonStringify(body)
  if (serializeErr !== null) {
    return [null, wrapError('serialize response', serializeErr)]
  }
  if (json === null) {
    return [null, new Error('serialization returned null')]
  }
  return [
    new Response(json, {
      status,
      headers: { 'Content-Type': 'application/json' },
    }),
    null,
  ]
}

function httpError(
  message: string,
  status: number,
): [Response | null, Error | null] {
  const [json, serializeErr] = jsonStringify({ error: message })
  if (serializeErr !== null) {
    return [null, wrapError('serialize error response', serializeErr)]
  }
  if (json === null) {
    return [null, new Error('serialization returned null')]
  }
  return [
    new Response(json, {
      status,
      headers: { 'Content-Type': 'application/json' },
    }),
    null,
  ]
}

export function handleList(): [Response | null, Error | null] {
  return jsonOk(listTodos(), 200)
}

export function handleGet(id: number): [Response | null, Error | null] {
  const [todo, findErr] = getTodo(id)
  if (findErr !== null) {
    return httpError(`todo ${id} not found`, 404)
  }
  if (todo === null) {
    return httpError(`todo ${id} not found`, 404)
  }
  return jsonOk(todo, 200)
}

export async function handleCreate(req: Request): ShotPromise<Response> {
  const text = await req.text()
  const [raw, parseErr] = jsonParse(text)
  if (parseErr !== null) {
    return httpError('invalid JSON body', 400)
  }
  const [input, validErr] = parse<CreateInput>(createSchema, raw)
  if (validErr !== null) {
    return httpError(`invalid request: ${validErr.message}`, 400)
  }
  if (input === null) {
    return httpError('missing request body', 400)
  }
  const [todo, createErr] = createTodo(input)
  if (createErr !== null) {
    return httpError(createErr.message, 400)
  }
  if (todo === null) {
    return httpError('failed to create todo', 500)
  }
  return jsonOk(todo, 201)
}

export async function handleUpdate(
  req: Request,
  id: number,
): ShotPromise<Response> {
  const text = await req.text()
  const [raw, parseErr] = jsonParse(text)
  if (parseErr !== null) {
    return httpError('invalid JSON body', 400)
  }
  const [input, validErr] = parse<UpdateInput>(updateSchema, raw)
  if (validErr !== null) {
    return httpError(`invalid request: ${validErr.message}`, 400)
  }
  if (input === null) {
    return httpError('missing request body', 400)
  }
  const [todo, updateErr] = updateTodo(id, input)
  if (updateErr !== null) {
    return httpError(`todo ${id} not found`, 404)
  }
  if (todo === null) {
    return httpError('failed to update todo', 500)
  }
  return jsonOk(todo, 200)
}

export function handleDelete(id: number): [Response | null, Error | null] {
  const [_result, deleteErr] = deleteTodo(id)
  if (deleteErr !== null) {
    return httpError(`todo ${id} not found`, 404)
  }
  return [new Response(null, { status: 204 }), null]
}
