import {
    clearTodos,
    createTodo,
    deleteTodo,
    getTodo,
    listTodos,
    updateTodo,
} from './store.shot'
import { test, expect } from 'bun:test'

test('createTodo adds a todo with trimmed title', function testCreateTodo(): void {
    clearTodos()
    const [todo, err] = createTodo({ title: '  buy milk  ' })
    expect(err).toBeNull()
    expect(todo).not.toBeNull()
    if (todo === null) {
        return
    }
    expect(todo.title).toBe('buy milk')
    expect(todo.done).toBe(false)
    expect(todo.id).not.toBe(0)
})

test('createTodo rejects empty title', function testCreateTodoEmpty(): void {
    clearTodos()
    const [todo, err] = createTodo({ title: '   ' })
    expect(todo).toBeNull()
    expect(err).toBeInstanceOf(Error)
    if (err === null) {
        return
    }
    expect(err.message).toBe('title must not be empty')
})

test('createTodo assigns incrementing ids', function testCreateTodoIds(): void {
    clearTodos()
    const [first, firstErr] = createTodo({ title: 'first' })
    const [second, secondErr] = createTodo({ title: 'second' })
    expect(firstErr).toBeNull()
    expect(secondErr).toBeNull()
    if (first === null || second === null) {
        return
    }
    expect(first.id).not.toBe(second.id)
})

test('listTodos returns all todos in insertion order', function testListTodos(): void {
    clearTodos()
    createTodo({ title: 'alpha' })
    createTodo({ title: 'beta' })
    createTodo({ title: 'gamma' })
    const all = listTodos()
    expect(all.length).toBe(3)
    const first = all[0]
    const third = all[2]
    if (first === undefined || third === undefined) {
        return
    }
    expect(first.title).toBe('alpha')
    expect(third.title).toBe('gamma')
})

test('getTodo returns the matching todo', function testGetTodo(): void {
    clearTodos()
    const [created, createErr] = createTodo({ title: 'find me' })
    expect(createErr).toBeNull()
    if (created === null) {
        return
    }
    const [found, findErr] = getTodo(created.id)
    expect(findErr).toBeNull()
    expect(found).not.toBeNull()
    if (found === null) {
        return
    }
    expect(found.id).toBe(created.id)
    expect(found.title).toBe('find me')
})

test('getTodo returns error for unknown id', function testGetTodoMissing(): void {
    clearTodos()
    const [todo, err] = getTodo(99999)
    expect(todo).toBeNull()
    expect(err).toBeInstanceOf(Error)
})

test('updateTodo flips done status', function testUpdateTodo(): void {
    clearTodos()
    const [created, createErr] = createTodo({ title: 'finish me' })
    expect(createErr).toBeNull()
    if (created === null) {
        return
    }
    const [updated, updateErr] = updateTodo(created.id, { done: true })
    expect(updateErr).toBeNull()
    expect(updated).not.toBeNull()
    if (updated === null) {
        return
    }
    expect(updated.done).toBe(true)
    expect(updated.title).toBe('finish me')
})

test('updateTodo returns wrapped error for unknown id', function testUpdateTodoMissing(): void {
    clearTodos()
    const [todo, err] = updateTodo(99999, { done: true })
    expect(todo).toBeNull()
    expect(err).toBeInstanceOf(Error)
    if (err === null) {
        return
    }
    expect(err.message.indexOf('update todo')).not.toBe(-1)
})

test('deleteTodo removes the todo', function testDeleteTodo(): void {
    clearTodos()
    const [created, createErr] = createTodo({ title: 'delete me' })
    expect(createErr).toBeNull()
    if (created === null) {
        return
    }
    const [_result, deleteErr] = deleteTodo(created.id)
    expect(deleteErr).toBeNull()
    expect(listTodos().length).toBe(0)
})

test('deleteTodo returns wrapped error for unknown id', function testDeleteTodoMissing(): void {
    clearTodos()
    const [_result, err] = deleteTodo(99999)
    expect(err).toBeInstanceOf(Error)
    if (err === null) {
        return
    }
    expect(err.message.indexOf('delete todo')).not.toBe(-1)
})
