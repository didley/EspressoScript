import { mutableRef, wrapError } from "shot:std"

export type Todo = {
    readonly id: number
    readonly title: string
    readonly done: boolean
}

const _todos = mutableRef<readonly Todo[]>([])
const _nextId = mutableRef(1)

export function allTodos(): readonly Todo[] {
    return _todos.value
}

export function addTodo(title: string): [Todo | null, Error | null] {
    const trimmed = title.trim()
    if (trimmed.length === 0) {
        return [null, new Error("title must not be empty")]
    }
    const todo: Todo = { id: _nextId.value, title: trimmed, done: false }
    _nextId.value = _nextId.value + 1
    _todos.value = [..._todos.value, todo]
    return [todo, null]
}

export function toggleTodo(id: number): [Todo | null, Error | null] {
    const [found, findErr] = findById(id)
    if (findErr !== null) {
        return [null, wrapError(`toggle todo ${id}`, findErr)]
    }
    if (found === null) {
        return [null, new Error(`todo ${id} not found`)]
    }
    const updated: Todo = { id: found.id, title: found.title, done: !found.done }
    _todos.value = _todos.value.map(function remapToggle(t: Todo): Todo {
        if (t.id === id) {
            return updated
        }
        return t
    })
    return [updated, null]
}

export function removeTodo(id: number): [null, Error | null] {
    const [_found, findErr] = findById(id)
    if (findErr !== null) {
        return [null, wrapError(`remove todo ${id}`, findErr)]
    }
    _todos.value = _todos.value.filter(function keepOthers(t: Todo): boolean {
        return t.id !== id
    })
    return [null, null]
}

function findById(id: number): [Todo | null, Error | null] {
    for (const todo of _todos.value) {
        if (todo.id === id) {
            return [todo, null]
        }
    }
    return [null, new Error(`todo ${id} not found`)]
}
