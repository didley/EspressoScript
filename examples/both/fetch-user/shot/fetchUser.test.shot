import { fetchUser } from './fetchUser.shot'
import { test, expect } from 'bun:test'

test('fetchUser returns a user for a valid id', async function testFetchUserValid(): Promise<void> {
    const [user, err] = await fetchUser(1)
    expect(err).toBeNull()
    expect(user).not.toBeNull()
    if (user === null) {
        return
    }
    expect(user.id).toBe(1)
    expect(user.name).not.toBe('')
    expect(user.email).not.toBe('')
})

test('fetchUser returns error for invalid id', async function testFetchUserInvalid(): Promise<void> {
    const [user, err] = await fetchUser(999999)
    expect(user).toBeNull()
    expect(err).toBeInstanceOf(Error)
})
