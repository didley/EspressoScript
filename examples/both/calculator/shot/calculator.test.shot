import { add, subtract, multiply, divide } from './calculator.shot'
import { test, expect } from 'bun:test'

test('add returns sum', function testAdd(): void {
    expect(add(10, 5)).toBe(15)
    expect(add(-3, 3)).toBe(0)
})

test('subtract returns difference', function testSubtract(): void {
    expect(subtract(10, 5)).toBe(5)
    expect(subtract(3, 7)).toBe(-4)
})

test('multiply returns product', function testMultiply(): void {
    expect(multiply(4, 5)).toBe(20)
    expect(multiply(-2, 3)).toBe(-6)
})

test('divide returns quotient', function testDivide(): void {
    const [result, err] = divide(10, 2)
    expect(err).toBeNull()
    expect(result).toBe(5)
})

test('divide by zero returns error', function testDivideByZero(): void {
    const [result, err] = divide(10, 0)
    expect(result).toBeNull()
    expect(err).toBeInstanceOf(Error)
    if (err === null) {
        return
    }
    expect(err.message).toBe('division by zero')
})
