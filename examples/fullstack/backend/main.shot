import { jsonParse, jsonStringify, wrapError } from 'shot:std'
import { addItem, listItems } from './store.shot'

type AddInput = {
    readonly title: string
}

async function dispatch(req: Request): Promise<[Response | null, Error | null]> {
    const url = new URL(req.url)
    const headers = {
        'Content-Type': 'application/json',
        'Access-Control-Allow-Origin': '*',
    }

    if (req.method === 'OPTIONS') {
        return [new Response(null, { status: 204, headers: { 'Access-Control-Allow-Origin': '*', 'Access-Control-Allow-Methods': 'GET, POST, OPTIONS', 'Access-Control-Allow-Headers': 'Content-Type' } }), null]
    }

    if (req.method === 'GET' && url.pathname === '/items') {
        const [json, err] = jsonStringify(listItems())
        if (err !== null) return [null, wrapError('serialize items', err)]
        if (json === null) return [null, new Error('serialization returned null')]
        return [new Response(json, { status: 200, headers }), null]
    }

    if (req.method === 'POST' && url.pathname === '/items') {
        const text = await req.text()
        const [raw, parseErr] = jsonParse<AddInput>(text)
        if (parseErr !== null) return [new Response('{"error":"invalid JSON"}', { status: 400, headers }), null]
        if (raw === null) return [new Response('{"error":"missing body"}', { status: 400, headers }), null]
        const [item, addErr] = addItem(raw.title)
        if (addErr !== null) return [new Response(`{"error":"${addErr.message}"}`, { status: 400, headers }), null]
        if (item === null) return [null, new Error('addItem returned null')]
        const [json, serErr] = jsonStringify(item)
        if (serErr !== null) return [null, wrapError('serialize item', serErr)]
        if (json === null) return [null, new Error('serialization returned null')]
        return [new Response(json, { status: 201, headers }), null]
    }

    return [new Response('{"error":"not found"}', { status: 404, headers }), null]
}

console.log('fullstack backend listening on :8000')
Bun.serve({
    async fetch(req: Request): Promise<Response> {
        const [res, err] = await dispatch(req)
        if (err !== null || res === null) {
            return new Response('{"error":"internal server error"}', { status: 500, headers: { 'Content-Type': 'application/json' } })
        }
        return res
    },
})
