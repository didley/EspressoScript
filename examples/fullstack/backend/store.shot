export type Item = {
    readonly id: number
    readonly title: string
}

const _items: Map<number, Item> = new Map()
const _nextId: [number] = [1]

export function listItems(): readonly Item[] {
    return Array.from(_items.values())
}

export function addItem(title: string): [Item | null, Error | null] {
    const trimmed = title.trim()
    if (trimmed.length === 0) {
        return [null, new Error('title must not be empty')]
    }
    const id = _nextId[0]
    const item: Item = { id, title: trimmed }
    _items.set(id, item)
    _nextId[0] = id + 1
    return [item, null]
}

export function clearItems(): void {
    _items.clear()
    _nextId[0] = 1
}
