import { mutableRef, wrapError } from 'shot:std'

export type Note = {
  readonly id: number
  readonly title: string
  readonly body: string
  readonly createdAt: string
}

export type CreateInput = {
  readonly title: string
  readonly body: string
}

const _notes = mutableRef<readonly Note[]>([])
const _nextId = mutableRef(1)

export function listNotes(): readonly Note[] {
  return _notes.value
}

export function getNote(id: number): [Note | null, Error | null] {
  for (const note of _notes.value) {
    if (note.id === id) {
      return [note, null]
    }
  }
  return [null, new Error(`note ${id} not found`)]
}

export function createNote(input: CreateInput): [Note | null, Error | null] {
  const title = input.title.trim()
  if (title.length === 0) {
    return [null, new Error('title must not be empty')]
  }
  const note: Note = {
    id: _nextId.value,
    title,
    body: input.body,
    createdAt: new Date().toISOString(),
  }
  _nextId.value = _nextId.value + 1
  _notes.value = [..._notes.value, note]
  return [note, null]
}

export function deleteNote(id: number): [null, Error | null] {
  const [_found, findErr] = getNote(id)
  if (findErr !== null) {
    return [null, wrapError(`delete note ${id}`, findErr)]
  }
  _notes.value = _notes.value.filter(function excludeDeleted(n: Note): boolean {
    return n.id !== id
  })
  return [null, null]
}

export function clearNotes(): void {
  _notes.value = []
  _nextId.value = 1
}
