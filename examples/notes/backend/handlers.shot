import { jsonParse, jsonStringify, wrapError } from 'shot:std'
import type { ShotPromise } from 'shot:std'
import { createNote, deleteNote, getNote, listNotes } from './store.shot'
import type { CreateInput } from './store.shot'

function jsonOk(body: unknown, status: number): [Response | null, Error | null] {
  const [json, serializeErr] = jsonStringify(body)
  if (serializeErr !== null) {
    return [null, wrapError('serialize response', serializeErr)]
  }
  if (json === null) {
    return [null, new Error('serialization returned null')]
  }
  return [
    new Response(json, {
      status,
      headers: {
        'Content-Type': 'application/json',
        'Access-Control-Allow-Origin': '*',
      },
    }),
    null,
  ]
}

function httpError(message: string, status: number): [Response | null, Error | null] {
  const [json, serializeErr] = jsonStringify({ error: message })
  if (serializeErr !== null) {
    return [null, wrapError('serialize error response', serializeErr)]
  }
  if (json === null) {
    return [null, new Error('serialization returned null')]
  }
  return [
    new Response(json, {
      status,
      headers: {
        'Content-Type': 'application/json',
        'Access-Control-Allow-Origin': '*',
      },
    }),
    null,
  ]
}

export function handleList(): [Response | null, Error | null] {
  return jsonOk(listNotes(), 200)
}

export function handleGet(id: number): [Response | null, Error | null] {
  const [note, findErr] = getNote(id)
  if (findErr !== null) {
    return httpError(`note ${id} not found`, 404)
  }
  if (note === null) {
    return httpError(`note ${id} not found`, 404)
  }
  return jsonOk(note, 200)
}

export async function handleCreate(req: Request): ShotPromise<Response> {
  const text = await req.text()
  const [input, parseErr] = jsonParse<CreateInput>(text)
  if (parseErr !== null) {
    return httpError('invalid JSON body', 400)
  }
  if (input === null) {
    return httpError('missing request body', 400)
  }
  const [note, createErr] = createNote(input)
  if (createErr !== null) {
    return httpError(createErr.message, 400)
  }
  if (note === null) {
    return httpError('failed to create note', 500)
  }
  return jsonOk(note, 201)
}

export function handleDelete(id: number): [Response | null, Error | null] {
  const [_result, deleteErr] = deleteNote(id)
  if (deleteErr !== null) {
    return httpError(`note ${id} not found`, 404)
  }
  return [
    new Response(null, {
      status: 204,
      headers: { 'Access-Control-Allow-Origin': '*' },
    }),
    null,
  ]
}
