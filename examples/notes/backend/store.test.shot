import { clearNotes, createNote, deleteNote, getNote, listNotes } from './store.shot'
import { test, expect } from 'bun:test'

test('createNote adds a note with trimmed title', function testCreateNote(): void {
    clearNotes()
    const [note, err] = createNote({ title: '  buy milk  ', body: 'from the shop' })
    expect(err).toBeNull()
    expect(note).not.toBeNull()
    if (note === null) {
        return
    }
    expect(note.title).toBe('buy milk')
    expect(note.body).toBe('from the shop')
    expect(note.id).not.toBe(0)
    expect(note.createdAt).not.toBe('')
})

test('createNote rejects empty title', function testCreateNoteEmpty(): void {
    clearNotes()
    const [note, err] = createNote({ title: '   ', body: '' })
    expect(note).toBeNull()
    expect(err).toBeInstanceOf(Error)
    if (err === null) {
        return
    }
    expect(err.message).toBe('title must not be empty')
})

test('createNote assigns incrementing ids', function testCreateNoteIds(): void {
    clearNotes()
    const [first, firstErr] = createNote({ title: 'first', body: '' })
    const [second, secondErr] = createNote({ title: 'second', body: '' })
    expect(firstErr).toBeNull()
    expect(secondErr).toBeNull()
    if (first === null || second === null) {
        return
    }
    expect(first.id).not.toBe(second.id)
})

test('listNotes returns all notes in insertion order', function testListNotes(): void {
    clearNotes()
    createNote({ title: 'alpha', body: '' })
    createNote({ title: 'beta', body: '' })
    createNote({ title: 'gamma', body: '' })
    const all = listNotes()
    expect(all.length).toBe(3)
    const first = all[0]
    const third = all[2]
    if (first === undefined || third === undefined) {
        return
    }
    expect(first.title).toBe('alpha')
    expect(third.title).toBe('gamma')
})

test('getNote returns the matching note', function testGetNote(): void {
    clearNotes()
    const [created, createErr] = createNote({ title: 'find me', body: 'here' })
    expect(createErr).toBeNull()
    if (created === null) {
        return
    }
    const [found, findErr] = getNote(created.id)
    expect(findErr).toBeNull()
    expect(found).not.toBeNull()
    if (found === null) {
        return
    }
    expect(found.id).toBe(created.id)
    expect(found.title).toBe('find me')
})

test('getNote returns error for unknown id', function testGetNoteMissing(): void {
    clearNotes()
    const [note, err] = getNote(99999)
    expect(note).toBeNull()
    expect(err).toBeInstanceOf(Error)
})

test('deleteNote removes the note', function testDeleteNote(): void {
    clearNotes()
    const [created, createErr] = createNote({ title: 'delete me', body: '' })
    expect(createErr).toBeNull()
    if (created === null) {
        return
    }
    const [_result, deleteErr] = deleteNote(created.id)
    expect(deleteErr).toBeNull()
    expect(listNotes().length).toBe(0)
})

test('deleteNote returns wrapped error for unknown id', function testDeleteNoteMissing(): void {
    clearNotes()
    const [_result, err] = deleteNote(99999)
    expect(err).toBeInstanceOf(Error)
    if (err === null) {
        return
    }
    expect(err.message.indexOf('delete note')).not.toBe(-1)
})
