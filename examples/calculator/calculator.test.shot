import { add, subtract, multiply, divide } from "./calculator.shot"
import { assertEquals, assertInstanceOf } from "shot:assert"

Deno.test("add returns sum", function testAdd(): void {
    assertEquals(add(10, 5), 15)
    assertEquals(add(-3, 3), 0)
})

Deno.test("subtract returns difference", function testSubtract(): void {
    assertEquals(subtract(10, 5), 5)
    assertEquals(subtract(3, 7), -4)
})

Deno.test("multiply returns product", function testMultiply(): void {
    assertEquals(multiply(4, 5), 20)
    assertEquals(multiply(-2, 3), -6)
})

Deno.test("divide returns quotient", function testDivide(): void {
    const [result, err] = divide(10, 2)
    assertEquals(err, null)
    assertEquals(result, 5)
})

Deno.test("divide by zero returns error", function testDivideByZero(): void {
    const [result, err] = divide(10, 0)
    assertEquals(result, null)
    assertInstanceOf(err, Error)
    assertEquals(err.message, "division by zero")
})
