import { fetchUser } from "./fetchUser.shot"
import { assertEquals, assertNotEquals, assertInstanceOf } from "shot:assert"

Deno.test("fetchUser returns a user for a valid id", async function testFetchUserValid(): Promise<void> {
    const [user, err] = await fetchUser(1)
    assertEquals(err, null)
    assertNotEquals(user, null)
    if (user === null) {
        return
    }
    assertEquals(user.id, 1)
    assertNotEquals(user.name, "")
    assertNotEquals(user.email, "")
})

Deno.test("fetchUser returns error for invalid id", async function testFetchUserInvalid(): Promise<void> {
    const [user, err] = await fetchUser(999999)
    assertEquals(user, null)
    assertInstanceOf(err, Error)
})
