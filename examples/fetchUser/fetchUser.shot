import { safeFetch, jsonParse } from 'shot:std'
import { parse, z } from 'shot:zod'

const userSchema = z.object({
    id: z.number(),
    name: z.string(),
    email: z.string(),
})

type User = {
    readonly id: number
    readonly name: string
    readonly email: string
}

export async function fetchUser(id: number): Promise<[User | null, Error | null]> {
    const url = `https://jsonplaceholder.typicode.com/users/${id}`
    const [res, fetchErr] = await safeFetch(url)
    if (fetchErr !== null) {
        return [null, fetchErr]
    }
    if (res === null || !res.ok) {
        return [null, new Error(`HTTP error fetching user ${id}`)]
    }
    const body = await res.text()
    const [raw, parseErr] = jsonParse(body)
    if (parseErr !== null) {
        return [null, parseErr]
    }
    const [user, validErr] = parse<User>(userSchema, raw)
    if (validErr !== null) {
        return [null, validErr]
    }
    return [user, null]
}

async function main(): Promise<void> {
    const [user, err] = await fetchUser(1)
    if (err !== null) {
        console.error(`error: ${err.message}`)
        process.exit(1)
    }
    if (user === null) {
        console.error(`no user returned`)
        process.exit(1)
    }
    console.log(`name:  ${user.name}`)
    console.log(`email: ${user.email}`)
}

if (import.meta.main) {
    main()
}
