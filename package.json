{
  "name": "shotscript",
  "version": "0.1.6",
  "description": "ShotScript — TypeScript, one way. Linting, formatting, standard library, and strict type config.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/didley/shotscript.git"
  },
  "exports": {
    ".": {
      "import": "./dist/lint/index.js",
      "types": "./dist/lint/index.d.ts"
    },
    "./std": {
      "import": "./dist/std/index.js",
      "types": "./dist/std/index.d.ts"
    },
    "./plugin": "./dist/lintTsPlugin.cjs",
    "./tsconfig/shotscript.json": "./src/tsconfig/shotscript.json",
    "./fmt": "./src/fmt/shotscript.json"
  },
  "bin": {
    "shotscript": "./dist/lintCli.js"
  },
  "main": "./dist/lint/index.js",
  "types": "./dist/lint/index.d.ts",
  "files": [
    "dist/",
    "templates/",
    "commands/",
    "src/tsconfig/",
    "src/fmt/"
  ],
  "scripts": {
    "build": "tsc && esbuild src/lintTsPlugin.ts --bundle --platform=node --format=cjs --external:typescript --outfile=dist/lintTsPlugin.cjs --footer:js='module.exports=module.exports.default??module.exports;'",
    "build:site": "node scripts/build-site.mjs",
    "serve": "node scripts/serve-site.mjs",
    "reduction": "node scripts/syntax-reduction-data.mjs",
    "test": "node --import tsx/esm tests/runner.ts && node --import tsx/esm --test tests/std.test.ts",
    "check": "tsc --noEmit",
    "lint": "node --import tsx/esm src/lintCli.ts 'src/lint/**/*.ts' 'src/lintCli.ts'",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "glob": "^11.0.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "tsx": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
